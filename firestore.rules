rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserCompanyId() {
      return getUserProfile().companyId;
    }

    function getUserRole() {
      return getUserProfile().role;
    }

    function isUserActive() {
      return getUserProfile().status == 'ACTIVE';
    }

    function isPlatformAdmin() {
      return isSignedIn() && isUserActive() &&
        (getUserRole() == 'PLATFORM_ADMIN' || getUserRole() == 'SUPER_ADMIN');
    }

    function isCompanyAdmin() {
      return isSignedIn() && isUserActive() &&
        (getUserRole() == 'COMPANY_ADMIN' || isPlatformAdmin());
    }

    function isHR() {
      return isSignedIn() && isUserActive() && getUserRole() == 'HR';
    }

    function isPeopleOps() {
      return isCompanyAdmin() || isHR();
    }

    function isManagerRole() {
      return isSignedIn() && isUserActive() && getUserRole() == 'MANAGER';
    }

    function isTeamLeadRole() {
      return isSignedIn() && isUserActive() && getUserRole() == 'TEAM_LEAD';
    }

    function isTeamLeadOrManager() {
      return isManagerRole() || isTeamLeadRole();
    }

    function belongsToCompany(companyId) {
      return isSignedIn() && isUserActive() &&
        (getUserCompanyId() == companyId || isPlatformAdmin());
    }

    function sameCompanyDoc() {
      return resource.data.companyId == getUserCompanyId();
    }

    function sameCompanyCreate() {
      return request.resource.data.companyId == getUserCompanyId();
    }

    function isDirectManagerOf(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.companyId == getUserCompanyId() &&
        get(/databases/$(database)/documents/users/$(uid)).data.reportingManagerUid == request.auth.uid;
    }

    function isSkipLevelManagerOf(uid) {
      return isManagerRole() &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        exists(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/users/$(uid)).data.reportingManagerUid)) &&
        get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/users/$(uid)).data.reportingManagerUid)).data.reportingManagerUid == request.auth.uid;
    }

    function canApprovePerson(uid) {
      return isPeopleOps() || isDirectManagerOf(uid) || isSkipLevelManagerOf(uid);
    }

    function canReadCompanyOps() {
      return isPeopleOps() || isTeamLeadOrManager();
    }

    match /companies/{companyId} {
      allow read: if isSignedIn() && (isPlatformAdmin() || belongsToCompany(companyId) || resource == null);

      allow create: if isSignedIn() && (
        isPlatformAdmin() ||
        request.resource.data.createdBy == request.auth.uid
      );

      allow update, delete: if isPlatformAdmin() || (isCompanyAdmin() && belongsToCompany(companyId));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        request.auth.uid == userId ||
        (canReadCompanyOps() && resource.data.companyId == getUserCompanyId())
      );

      allow create: if isSignedIn() && (
        isPlatformAdmin() ||
        (request.auth.uid == userId && (request.resource.data.role == 'COMPANY_ADMIN' || request.resource.data.role == 'PLATFORM_ADMIN' || request.resource.data.role == 'SUPER_ADMIN')) ||
        (isPeopleOps() && request.resource.data.companyId == getUserCompanyId())
      );

      allow update: if isSignedIn() && (
        isPlatformAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.companyId == resource.data.companyId
        ) ||
        (
          isPeopleOps() &&
          resource.data.companyId == getUserCompanyId() &&
          request.resource.data.companyId == getUserCompanyId()
        )
      );

      allow delete: if isPlatformAdmin() || (
        isCompanyAdmin() &&
        resource.data.companyId == getUserCompanyId() &&
        request.auth.uid != userId
      );
    }

    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        resource.data.uid == request.auth.uid ||
        (canReadCompanyOps() && sameCompanyDoc())
      );

      allow create: if isSignedIn() && sameCompanyCreate() && (
        request.resource.data.uid == request.auth.uid ||
        isPeopleOps()
      );

      allow update: if isSignedIn() && (
        isPlatformAdmin() ||
        (resource.data.uid == request.auth.uid && sameCompanyCreate()) ||
        (isPeopleOps() && sameCompanyDoc())
      );

      allow delete: if isPlatformAdmin() || (isCompanyAdmin() && sameCompanyDoc());
    }

    match /leave_requests/{requestId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        resource.data.uid == request.auth.uid ||
        (canReadCompanyOps() && sameCompanyDoc())
      );

      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        sameCompanyCreate() &&
        request.resource.data.status == 'PENDING';

      allow update: if isSignedIn() && (
        isPlatformAdmin() ||
        (
          request.auth.uid == resource.data.uid &&
          resource.data.status == 'PENDING' &&
          request.resource.data.status == 'CANCELLED'
        ) ||
        (
          sameCompanyDoc() &&
          canApprovePerson(resource.data.uid)
        )
      );

      allow delete: if isPlatformAdmin() || (isCompanyAdmin() && sameCompanyDoc());
    }

    match /timesheets/{entryId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        resource.data.uid == request.auth.uid ||
        (canReadCompanyOps() && sameCompanyDoc())
      );

      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        sameCompanyCreate();

      allow update: if isSignedIn() && (
        (resource.data.uid == request.auth.uid && resource.data.status == 'PENDING') ||
        (sameCompanyDoc() && canApprovePerson(resource.data.uid))
      );

      allow delete: if isPeopleOps() && sameCompanyDoc();
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        resource.data.uid == request.auth.uid ||
        (canReadCompanyOps() && sameCompanyDoc())
      );

      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        sameCompanyCreate();

      allow update: if isSignedIn() && (
        (resource.data.uid == request.auth.uid && resource.data.status == 'PENDING') ||
        (sameCompanyDoc() && canApprovePerson(resource.data.uid))
      );

      allow delete: if isPeopleOps() && sameCompanyDoc();
    }

    match /assets/{assetId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        resource.data.assignedUid == request.auth.uid ||
        (canReadCompanyOps() && sameCompanyDoc())
      );

      allow create, update, delete: if isPeopleOps() &&
        (request.resource.data.companyId == getUserCompanyId() || sameCompanyDoc());
    }

    match /performance_goals/{goalId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        resource.data.uid == request.auth.uid ||
        (canReadCompanyOps() && sameCompanyDoc())
      );

      allow create, update: if isSignedIn() && (
        (request.resource.data.uid == request.auth.uid && sameCompanyCreate()) ||
        (sameCompanyCreate() && canApprovePerson(request.resource.data.uid)) ||
        (resource != null && sameCompanyDoc() && canApprovePerson(resource.data.uid))
      );

      allow delete: if isPeopleOps() && sameCompanyDoc();
    }

    match /candidates/{candidateId} {
      allow read, create, update, delete: if isPeopleOps() &&
        (resource == null || sameCompanyDoc() || sameCompanyCreate());
    }

    match /payslips/{payslipId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        resource.data.uid == request.auth.uid ||
        (isPeopleOps() && sameCompanyDoc())
      );

      allow create, update, delete: if isPeopleOps() &&
        (resource == null || sameCompanyDoc() || sameCompanyCreate());
    }

    match /letters/{letterId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        resource.data.uid == request.auth.uid ||
        (isPeopleOps() && sameCompanyDoc())
      );

      allow create, update, delete: if isPeopleOps() &&
        (resource == null || sameCompanyDoc() || sameCompanyCreate());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
